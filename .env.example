# ==============================================================================
# TIE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND (Vercel Project Settings -> Environment Variables)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://plqfhwbiueirwcldcjfn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SITE_URL=https://tie-gray.vercel.app

# Set this to your Render Backend Service URL once deployed (e.g. https://tie-backend.onrender.com)
NEXT_PUBLIC_API_URL=https://your-backend-app.onrender.com

# ------------------------------------------------------------------------------
# 2. BACKEND (Render Web Service Settings -> Environment Variables)
# ------------------------------------------------------------------------------
# Production Frontend URL for activation links and invites sent in emails
FRONTEND_URL=https://tie-gray.vercel.app

# CORS origins permitted to call the backend API (comma-separated)
CORS_ORIGINS=https://tie-gray.vercel.app,http://localhost:3000

# Supabase Keys (Service role key bypasses RLS securely for background assessment scoring & invites)
SUPABASE_URL=https://plqfhwbiueirwcldcjfn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# LLM Keys
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key
LLM_PREFERENCE_ORDER=groq,gemini,openai

# Email Service (Resend is primary)
EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=onboarding@careerque.in
